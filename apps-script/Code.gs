// Private Google Sheets backend. Store FAMILY_PIN in Script properties.
function props_(){return PropertiesService.getScriptProperties();}
function sheet_(){var b=SpreadsheetApp.openById(props_().getProperty('SHEET_ID'));var s=b.getSheetByName('Items');if(!s){s=b.insertSheet('Items');s.appendRow(['ID','JSON','Revision']);}return s;}
function setup(){if(!props_().getProperty('FAMILY_PIN'))throw Error('Set FAMILY_PIN first');props_().setProperty('SHEET_ID',SpreadsheetApp.getActiveSpreadsheet().getId());sheet_();MailApp.getRemainingDailyQuota();backupFolder_();if(!ScriptApp.getProjectTriggers().some(function(t){return t.getHandlerFunction()==='reminderTick';}))ScriptApp.newTrigger('reminderTick').timeBased().everyMinutes(5).create();}
function json_(v){return ContentService.createTextOutput(JSON.stringify(v)).setMimeType(ContentService.MimeType.JSON);}
function doPost(e){var l=LockService.getScriptLock();if(!l.tryLock(15000))return json_({ok:false,error:'busy'});try{if(e.parameter&&e.parameter.done)return complete_(e.parameter.done);return json_(handle_(JSON.parse(e.postData.contents)));}catch(err){return json_({ok:false,error:'server',message:String(err.message)});}finally{l.releaseLock();}}
function handle_(r){var p=props_(),c=CacheService.getScriptCache(),pin=p.getProperty('FAMILY_PIN');if(!pin)return {ok:false,error:'setup'};
if(r.action==='unlock'){if(Number(p.getProperty('LOCK_UNTIL')||0)>Date.now())return {ok:false,error:'locked',minutes:15};if(String(r.pin)!==pin){var n=Number(p.getProperty('FAILURES')||0)+1;p.setProperty('FAILURES',String(n));if(n>=8){p.setProperty('LOCK_UNTIL',String(Date.now()+900000));p.setProperty('FAILURES','0');return {ok:false,error:'locked',minutes:15};}return {ok:false,error:'wrong_pin',remaining:8-n};}p.setProperty('FAILURES','0');var token=Utilities.getUuid()+Utilities.getUuid();c.put('token_'+token,pin,21600);return {ok:true,token:token};}
if(!r.token||c.get('token_'+r.token)!==pin)return {ok:false,error:'auth'};
if(r.appUrl&&/^https:\/\//.test(r.appUrl))p.setProperty('APP_URL',r.appUrl);
if(r.action==='feedLink'){var key=p.getProperty('FEED_KEY');if(!key||r.regenerate){key=Utilities.getUuid()+Utilities.getUuid();p.setProperty('FEED_KEY',key);}return {ok:true,url:ScriptApp.getService().getUrl()+'?feed='+key};}
if(r.action==='testNotify'){var family=items_().find(function(x){return x.id==='settings_family';});if(!family)return {ok:false,error:'send_failed',message:'Save family settings first.'};var person=family.people.find(function(x){return x.id===r.person;});if(!person||!person.notify||!person.notify.email)return {ok:false,error:'send_failed',message:'Add an email first.'};try{MailApp.sendEmail(person.notify.email,'Family Hub test','Reminders are working for '+person.name+'!');return {ok:true,reminders:timer_()};}catch(err){return {ok:false,error:'send_failed',message:String(err)};}}
if(r.action==='sync'){var s=sheet_(),rows=s.getDataRange().getValues().slice(1),ids={},rev=Number(p.getProperty('REVISION')||0),changes=r.changes||[];rows.forEach(function(x,i){ids[x[0]]=i+2;});if(changes.length>1000)return {ok:false,error:'too_large'};for(var i=0;i<changes.length;i++){var x=changes[i];if(!x||typeof x.id!=='string'||typeof x.type!=='string'||JSON.stringify(x).length>45000)return {ok:false,error:'invalid_change'};}changes.forEach(function(x){var row=[x.id,JSON.stringify(x),++rev];if(ids[x.id])s.getRange(ids[x.id],1,1,3).setValues([row]);else{s.appendRow(row);ids[x.id]=s.getLastRow();}});p.setProperty('REVISION',String(rev));return {ok:true,cursor:rev,items:s.getDataRange().getValues().slice(1).filter(function(x){return Number(x[2])>Number(r.since||0);}).map(function(x){return JSON.parse(x[1]);}),reminders:timer_()};}
if(r.action==='backupNow')return {ok:true,name:backup_().getName()};
return {ok:false,error:'unsupported',message:'Unknown operation.'};}
function items_(){return sheet_().getDataRange().getValues().slice(1).map(function(x){return JSON.parse(x[1]);});}
function timer_(){return ScriptApp.getProjectTriggers().some(function(t){return t.getHandlerFunction()==='reminderTick';});}
function backupFolder_(){var p=props_(),id=p.getProperty('BACKUP_FOLDER');if(id)return DriveApp.getFolderById(id);var f=DriveApp.createFolder('Family Hub Backups');p.setProperty('BACKUP_FOLDER',f.getId());return f;}
function backup_(){var folder=backupFolder_(),f=folder.createFile('Family-Hub-'+new Date().toISOString()+'.json',JSON.stringify({version:2,items:items_()}),MimeType.PLAIN_TEXT),it=folder.getFiles(),files=[];while(it.hasNext())files.push(it.next());files.sort(function(a,b){return b.getDateCreated()-a.getDateCreated();});files.slice(8).forEach(function(x){x.setTrashed(true);});return f;}
function doGet(e){var p=props_();if(e.parameter.feed&&e.parameter.feed===p.getProperty('FEED_KEY')){var who=e.parameter.who;return ContentService.createTextOutput(calendarFile(items_().filter(function(x){return !x.deleted&&x.type==='event'&&(!who||!x.people||!x.people.length||x.people.indexOf(who)>=0);}))).setMimeType(ContentService.MimeType.ICAL);}
 if(e.parameter.done){var cache=CacheService.getScriptCache(),raw=cache.get('done_'+e.parameter.done);if(!raw)return HtmlService.createHtmlOutput('This reminder expired. Open Family Hub to mark it done.');var job=JSON.parse(raw);return HtmlService.createHtmlOutput('<p>Mark this checklist item done?</p><form method="post" action="'+ScriptApp.getService().getUrl()+'"><input type="hidden" name="done" value="'+e.parameter.done+'"><button>✓ Mark it done</button></form>');}return json_({ok:false,error:'auth'});}
// Completion requires a button press, so email link scanners cannot finish jobs.
function complete_(token){var cache=CacheService.getScriptCache(),raw=cache.get('done_'+token);if(!raw)return HtmlService.createHtmlOutput('Expired reminder.');var job=JSON.parse(raw),p=props_(),s=sheet_(),id='rl_'+job.id+'_'+job.date,items=items_();var item={id:id,type:'routineLog',routineId:job.id,date:job.date,done:true,by:job.name,byId:job.person,at:Date.now(),updatedAt:Date.now()},row=items.findIndex(function(x){return x.id===id;})+2,rev=Number(p.getProperty('REVISION')||0)+1;if(row>1)s.getRange(row,1,1,3).setValues([[id,JSON.stringify(item),rev]]);else s.appendRow([id,JSON.stringify(item),rev]);p.setProperty('REVISION',String(rev));cache.remove('done_'+token);return HtmlService.createHtmlOutput('✓ Done. You can close this page.');}
function reminderTick(){var lock=LockService.getScriptLock();if(!lock.tryLock(1000))return;try{var p=props_(),items=items_(),settings=items.find(function(x){return x.id==='settings_family'&&!x.deleted;});if(!settings)return;var zone=settings.timezone||'America/Toronto',now=new Date(),date=Utilities.formatDate(now,zone,'yyyy-MM-dd'),minute=Number(Utilities.formatDate(now,zone,'H'))*60+Number(Utilities.formatDate(now,zone,'m')),events=items.filter(function(x){return x.type==='event'&&!x.deleted;}),cache=CacheService.getScriptCache();
 function send(person,key,title,body,html){if(cache.get(key)||!person.notify.email||MailApp.getRemainingDailyQuota()<1)return;MailApp.sendEmail({to:person.notify.email,subject:title,body:body,htmlBody:html||esc(body).replace(/\n/g,'<br>')});cache.put(key,'sent',21600);}
 settings.people.forEach(function(person){var n=person.notify||{};if(!n.email)return;var follow=n.follow&&n.follow.length?n.follow:[person.id];var involved=function(x){return !x.people||!x.people.length||x.people.some(function(id){return follow.indexOf(id)>=0;});};var occ=[];events.filter(involved).forEach(function(x){occ=occ.concat(occurrences(x,addDays(date,-1),addDays(date,7)));});
 occ.forEach(function(o){var rel=remindAt(o.ev);if(rel==null)return;var due=diffDays(date,o.date)*1440+rel;if(due<=minute&&due>minute-6)send(person,'ev_'+person.id+'_'+o.ev.id+'_'+o.date,'Family Hub: '+o.ev.title,fmtDate(o.date)+' · '+fmtRange(o.ev)+'\n'+(o.ev.location||'')+'\nBring: '+(o.ev.bring||''));});
 items.filter(function(x){return x.type==='routine'&&!x.deleted&&routineOn(x,date)&&x.remind!==false&&x.time&&involved(x);}).forEach(function(rt){if(items.some(function(x){return x.id==='rl_'+rt.id+'_'+date&&!x.deleted&&x.done;}))return;var due=toMin(rt.time);if(due>minute||!rt.nag&&minute>due+6)return;var nag=Math.max(5,Number(rt.nag)||1440),slot=Math.floor((minute-due)/nag),key='rt_'+person.id+'_'+rt.id+'_'+date+'_'+slot,token=Utilities.getUuid();cache.put('done_'+token,JSON.stringify({id:rt.id,date:date,person:person.id,name:person.name}),21600);var link=ScriptApp.getService().getUrl()+'?done='+token;send(person,key,'Family Hub: '+rt.title,rt.title+'\n'+link,esc(rt.title)+'<p><a href="'+link+'">✓ Mark it done</a></p>');});
 var summary=occ.filter(function(o){return o.date===date;}).map(function(o){return fmtRange(o.ev)+' '+o.ev.title;}).join('\n');if(n.summary&&minute>=toMin(n.summaryTime||'07:00')&&minute<toMin(n.summaryTime||'07:00')+15)send(person,'summary_'+person.id+'_'+date,'Family Hub: today',summary||'Nothing scheduled.');
 if(n.weekly&&dow(date)===Number(n.weeklyDay||0)&&minute>=toMin(n.weeklyTime||'18:00')&&minute<toMin(n.weeklyTime||'18:00')+15)send(person,'weekly_'+person.id+'_'+date,'Family Hub: week ahead',occ.filter(function(o){return o.date>=date;}).map(function(o){return fmtDate(o.date)+' '+fmtRange(o.ev)+' '+o.ev.title+' · '+(o.ev.location||'');}).join('\n')||'Nothing scheduled.');});
 if(dow(date)===0&&minute>=1200&&p.getProperty('LAST_BACKUP')!==date){backup_();p.setProperty('LAST_BACKUP',date);}
 }finally{lock.releaseLock();}}
